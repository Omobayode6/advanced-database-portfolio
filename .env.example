# Copy this file to .env and paste your own Supabase session-pooler URI.
# Dashboard: Connect -> Session pooler -> URI. Port 5432.
# User looks like postgres.[YOUR-PROJECT-REF].
# Do not commit .env. Do not put a real password in this example file.
# The transaction pooler on port 6543 is the wrong string for the concurrency demo.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
